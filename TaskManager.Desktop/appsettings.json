{
    "Database": {
        "UsePostgres": false,
        "ConnectionStrings": {
            "Postgres": "Host=localhost;Port=5432;Database=tasks;Username=postgres;Password=admin",
            "Sqlite": "Data Source=c:/data/tasks.db"
        }
    },
    "Logging": {
        "path": "logs/log-.txt",
        "rollingInterval": "Day",
        "retainedFileCountLimit": 7,
        "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message}{NewLine}{Exception}{Properties}{NewLine}"
    }
}